# Server Configuration
PROJECT_NAME="NutriCare API"
API_V1_STR="/api/v1"
SECRET_KEY="nutricare-super-secret-key-change-this-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nutricare_db
# Format: postgresql://user:password@server:port/db (or sqlite:///./nutricare.db for fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nutricare_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# AI Configuration (Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# MQTT IoT Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=nutricare/devices/

# Firebase / Push Notification
FIREBASE_CREDENTIALS_PATH=
AGORA_APP_ID=mock_agora_app_id
AGORA_APP_CERTIFICATE=mock_agora_certificate
